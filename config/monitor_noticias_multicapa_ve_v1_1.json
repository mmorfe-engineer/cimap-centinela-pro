social_alert_policy	
do_not_discard_by_default	true
purpose	"preservar señales tempranas sin presentarlas como hechos confirmados"
levels	
SA0_descartado	
definition	"contenido irrelevante, spam, propaganda sin dato verificable, duplicado o fuera de ventana temporal"
brief_visibility	"no incluir"
warning_label	"No incluido: señal irrelevante o no utilizable."
SA1_senal_no_verificada	
definition	"mención aislada o claim sin respaldo independiente suficiente"
brief_visibility	"solo bitácora interna o anexo de alertas"
warning_label	"Advertencia: señal no verificada; no tratar como hecho."
SA2_alerta_en_observacion	
definition	"señal repetida en varias cuentas/canales o con evidencia parcial, pero sin confirmación primaria"
brief_visibility	"sección de alertas tempranas con advertencia"
warning_label	"Advertencia: alerta en observación; requiere validación adicional."
SA3_alerta_verosimil	
definition	"señal coherente con evidencia OSINT, fuente recurrente o cobertura secundaria confiable"
brief_visibility	"sección de alertas tempranas y, si tiene alto impacto, mención breve en senales_clave"
warning_label	"Advertencia: señal verosímil, aún no confirmada oficialmente."
SA4_confirmado	
definition	"confirmado por fuente oficial, fuente primaria verificable o múltiples fuentes confiables independientes"
brief_visibility	"puede entrar al cuerpo principal del reporte"
warning_label	"Confirmado: validado por fuente primaria o contraste suficiente."
